[Unit]
Description=Claude.ai Usage Indicator for GNOME Topbar
Documentation=https://github.com/kiboko/claude-usage-indicator
After=graphical-session.target network-online.target
Wants=network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/claude-usage-indicator
Restart=on-failure
RestartSec=15
# Inherit the Wayland/D-Bus session environment populated by GNOME on login
PassEnvironment=DISPLAY WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR

[Install]
WantedBy=graphical-session.target